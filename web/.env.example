# Postgres connection string.
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
#   postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Lokal / home server:
#   postgresql://gh:gh@localhost:5432/greenhouse
DATABASE_URL=

# Opsional: login untuk dashboard (kosongkan = tanpa login)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Zona waktu untuk analytics harian
APP_TZ=Asia/Jakarta

# Opsional: notifikasi lewat bot Telegram. Kosongkan = nonaktif.
#   TELEGRAM_BOT_TOKEN: token dari @BotFather (/newbot). JANGAN di-commit.
#   TELEGRAM_CHAT_ID: chat ID tujuan bawaan, pisah koma (angka pribadi, -100... untuk grup, atau @namakanal).
#   Cara dapat chat ID: kirim /start ke bot, lalu tombol lonceng di dashboard → "Cari chat ID".
#   Tiap node bisa punya chat ID sendiri dan memilih jenis pesan dari tombol lonceng di dashboard-nya.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Rahasia untuk /api/cron/offline (cek node offline). Isi string acak: openssl rand -hex 16
CRON_SECRET=
# Menit tanpa data sebelum dikabarkan offline (default 5)
NOTIFY_OFFLINE_MIN=5
# Tautan dashboard di pesan (di Vercel otomatis dari domain production)
APP_URL=
# 1 = jangan kirim, cukup tulis pesan ke log server (uji)
NOTIFY_DRY_RUN=
